{
  "name": "online-resume",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:web": "pnpm --filter @online-resume/web dev",
    "dev:api": "pnpm --filter @online-resume/api dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "pnpm --filter @online-resume/web test:browser",
    "test:browser:ui": "pnpm --filter @online-resume/web test:browser:ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @online-resume/api db:generate",
    "db:push": "pnpm --filter @online-resume/api db:push",
    "db:seed": "pnpm --filter @online-resume/api db:seed",
    "prepare": "node -e \"if (require('node:fs').existsSync('.git')) require('node:child_process').execSync('lefthook install', { stdio: 'inherit' })\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
