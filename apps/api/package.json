{
  "name": "@online-resume/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "prisma generate --config ../../prisma.config.ts && nest start --watch",
    "build": "prisma generate --config ../../prisma.config.ts && nest build",
    "start": "node dist/main.js",
    "db:generate": "prisma generate --config ../../prisma.config.ts",
    "db:push": "prisma db push --config ../../prisma.config.ts",
    "db:seed": "pnpm run build && node dist/seed.js",
    "db:migrate": "prisma migrate deploy --config ../../prisma.config.ts",
    "openapi:generate": "pnpm run build && node dist/openapi.js",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@online-resume/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "12.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
