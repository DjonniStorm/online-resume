{
  "name": "@online-resume/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "prisma generate --config ../../prisma.config.ts && nest start --watch",
    "build": "prisma generate --config ../../prisma.config.ts && nest build",
    "start": "node dist/main.js",
    "db:generate": "prisma generate --config ../../prisma.config.ts",
    "db:push": "prisma db push --config ../../prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@online-resume/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.5",
    "@nestjs/schematics": "^12.0.4",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "typescript": "^6.0.3"
  }
}
