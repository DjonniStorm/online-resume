  "info": {
    "title": "Online Resume API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "resume_refresh"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "githubUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "pattern": "^https:\\/\\/(?:www\\.)?github\\.com\\/[^/?#]+(?:\\/[^?#]*)?$"
          },
          "telegramHandle": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_]{5,32}$"
          },
          "websiteUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          }
        },
        "required": ["email", "password", "firstName", "lastName"]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "githubUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          },
          "telegramHandle": {
            "type": "string",
            "nullable": true
          },
          "websiteUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          },
          "role": {
            "enum": ["USER", "ADMIN"],
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "githubUrl",
          "telegramHandle",
          "websiteUrl",
          "role",
          "createdAt",
          "updatedAt"
        ]
      },
      "AuthResultDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "enum": ["Bearer"],
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Срок действия access-токена в секундах."
          },
          "user": {
            "$ref": "#/components/schemas/PublicUserDto"
          }
        },
        "required": ["accessToken", "tokenType", "expiresIn", "user"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": ["email", "password"]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "githubUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 2048,
            "format": "uri",
            "pattern": "^https:\\/\\/(?:www\\.)?github\\.com\\/[^/?#]+(?:\\/[^?#]*)?$"
          },
          "telegramHandle": {
            "type": "string",
            "nullable": true,
            "pattern": "^@?[A-Za-z0-9_]{5,32}$"
          },
          "websiteUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 2048,
            "format": "uri"
          }
        }
      },
      "CreateResumeDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Резюме frontend-разработчика"
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Анна"
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Петрова"
          },
          "templateSlug": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "example": "left-rail"
          },
          "headline": {
            "type": "string",
            "maxLength": 200,
            "example": "Frontend-разработчик"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "anna@example.com"
          },
          "phone": {
            "type": "string",
            "maxLength": 50,
            "example": "+7 900 000-00-00"
          },
          "location": {
            "type": "string",
            "maxLength": 200,
            "example": "Москва"
          },
          "githubUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "pattern": "^https:\\/\\/(?:www\\.)?github\\.com\\/[^/?#]+(?:\\/[^?#]*)?$",
            "example": "https://github.com/example"
          },
          "telegramHandle": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_]{5,32}$",
            "example": "@example"
          },
          "websiteUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "example": "https://example.com"
          },
          "about": {
            "type": "string",
            "maxLength": 5000,
            "example": "Разрабатываю интерфейсы и сервисы..."
          }
        },
        "required": ["title", "firstName", "lastName", "templateSlug"]
      },
      "ResumeTemplateSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "slug", "name"]
      },
      "ResumeSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "template": {
            "$ref": "#/components/schemas/ResumeTemplateSummaryDto"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "title", "firstName", "lastName", "template", "createdAt", "updatedAt"]
      }
    }
  }
}
